{
  "expo": {
    "name": "Focus",
    "slug": "focus",
    "version": "0.7.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "focus",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F4EF",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.thulani.focus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#35676A"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.NFC",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.health.READ_SLEEP",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "focus"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#35676A"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Focus listens when you tap the mic so you can talk instead of type.",
          "speechRecognitionPermission": "Focus turns what you say into text so it can sort it.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Focus reads your diary to plan your day and adds dated things to it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4EF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#161A1C"
          }
        }
      ],
      "./plugins/withNfcRooms",
      "./plugins/withHomeScreen",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false,
          "locationAlwaysAndWhenInUsePermission": "Focus notices when you arrive home, at nursery or at the shop, so it can pause house jobs while you're out. Your location never leaves your phone."
        }
      ]
    ],
    "owner": "thulanilewis",
    "extra": {
      "eas": {
        "projectId": "43fac795-67c0-4288-b8b5-a47afbabf3b3"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/43fac795-67c0-4288-b8b5-a47afbabf3b3",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
